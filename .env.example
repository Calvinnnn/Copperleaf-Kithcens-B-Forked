# ============================================================
# Copperleaf Kitchens — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values:
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# NEVER commit the real .env file — it is listed in .gitignore
# ============================================================

# --- LLM Provider ---
# Required for the agent and RAG generator to produce answers.
OPENAI_API_KEY=your_openai_api_key_here

# --- Optional: HuggingFace Hub ---
# Set this to avoid rate-limiting warnings when downloading
# sentence-transformer embeddings (all-MiniLM-L6-v2).
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# --- Database path (default is fine for local dev) ---
# DB_PATH=db/copperleaf.db

# --- MCP Server settings ---
# MCP_TRANSPORT=stdio
# MCP_PORT=8000
